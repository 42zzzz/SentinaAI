# Mosquitto ACL rules (NFR-27)
#
# Topic convention:
#   sentina/v1/telemetry/<zoneId>/<deviceId>/<readingType>
#   sentina/v1/cmd/<deviceId>/#
#   sentina/v1/config/<deviceId>/#
#
# With mTLS enabled, Mosquitto uses the client certificate CN as the username
# (use_identity_as_username true). For password mode, the username is whatever
# the client provides.

# Service accounts
user telemetry-service
topic read  sentina/v1/telemetry/#
topic write sentina/v1/metrics/#

user nodered
topic read  sentina/v1/telemetry/#
topic write sentina/v1/cmd/#
topic write sentina/v1/config/#

# Default device permissions (pattern uses %u = username/deviceId)
pattern write sentina/v1/telemetry/+/%u/+
pattern read  sentina/v1/cmd/%u/#
pattern read  sentina/v1/config/%u/#

# (Optional) allow devices to publish heartbeats to a dedicated topic
pattern write sentina/v1/heartbeat/+/%u
