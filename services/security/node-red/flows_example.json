[
  {
    "id": "tab1",
    "type": "tab",
    "label": "SentinaAI TLS MQTT Demo",
    "disabled": false,
    "info": "Example only: shows how Node-RED would subscribe to TLS MQTT topics.\nConfigure the MQTT broker node to use: mqtts://mosquitto:8883 and point the TLS config to /data/certs/*."
  },
  {
    "id": "mqtt-in",
    "type": "mqtt in",
    "z": "tab1",
    "name": "Telemetry (TLS)",
    "topic": "sentina/v1/telemetry/#",
    "qos": "1",
    "datatype": "auto",
    "broker": "mqtt-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 180,
    "y": 120,
    "wires": [["debug"]]
  },
  {
    "id": "debug",
    "type": "debug",
    "z": "tab1",
    "name": "debug",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 380,
    "y": 120,
    "wires": []
  },
  {
    "id": "mqtt-broker",
    "type": "mqtt-broker",
    "name": "mosquitto (TLS)",
    "broker": "mosquitto",
    "port": "8883",
    "tls": "mqtt-tls",
    "clientid": "nodered",
    "usetls": true,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "willMsg": {}
  },
  {
    "id": "mqtt-tls",
    "type": "tls-config",
    "name": "MQTTS",
    "cert": "/data/certs/nodered.crt",
    "key": "/data/certs/nodered.key",
    "ca": "/data/certs/ca.crt",
    "verifyservercert": true
  }
]
